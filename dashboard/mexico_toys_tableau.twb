      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1w4pout1fqh8nl1c1nkue13endzq].[sum:days_cover_90d:qk]&quot;' value='Cover(days)' />
          <alias key='&quot;[federated.1w4pout1fqh8nl1c1nkue13endzq].[sum:revenue_90d:qk]&quot;' value='Revenue (90d)' />
          <alias key='&quot;[federated.1w4pout1fqh8nl1c1nkue13endzq].[sum:stock_on_hand:qk]&quot;' value='Stock' />
          <alias key='&quot;[federated.1w4pout1fqh8nl1c1nkue13endzq].[sum:units_30d:qk]&quot;' value='Units (30d)' />
        </aliases>
      </column>
      <column caption='Stockout Pairs' datatype='integer' name='[Calculation_0051931131654156]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [inventory_status] = &quot;Stockout with recent demand&quot;&#10;    THEN 1&#10;    ELSE 0&#10;    END&#10;)' />
      </column>
      <column caption='Excess Inventory Cost' datatype='real' default-format='c&quot;$&quot;#,##0,.0K;-&quot;$&quot;#,##0,.0K' name='[Calculation_0051931131723789]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [inventory_status] = &quot;High cover over 30 days&quot;&#10;       OR [inventory_status] = &quot;No recent sales&quot;&#10;    THEN [inventory_cost_value]&#10;    END&#10;)' />
      </column>
      <column caption='Inventory Cost' datatype='real' default-format='c&quot;$&quot;#,##0,.0K;-&quot;$&quot;#,##0,.0K' name='[Calculation_0051931131981841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([inventory_cost_value])' />
      </column>
      <column caption='Estimated Days Cover' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1691371711160320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [has_inventory_record] = 1&#10;    THEN [stock_on_hand]&#10;    END&#10;)&#10;/&#10;(&#10;    SUM(&#10;        IF [has_inventory_record] = 1&#10;        THEN [units_90d]&#10;        END&#10;    ) / 90&#10;)' />
      </column>
      <column caption='Inventory — Status' datatype='string' name='[Calculation_1691371717758978]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [inventory_status]&#10;WHEN &quot;Stockout with recent demand&quot; THEN &quot;Urgent&quot;&#10;WHEN &quot;Critical cover under 7 days&quot; THEN &quot;Urgent&quot;&#10;WHEN &quot;Low cover 7-13 days&quot; THEN &quot;Watch&quot;&#10;WHEN &quot;Balanced cover 14-30 days&quot; THEN &quot;Balanced&quot;&#10;WHEN &quot;High cover over 30 days&quot; THEN &quot;High / idle&quot;&#10;WHEN &quot;No recent sales&quot; THEN &quot;High / idle&quot;&#10;WHEN &quot;Missing inventory record&quot; THEN &quot;Data review&quot;&#10;END' />
      </column>
      <column caption='Store — Product' datatype='string' name='[Calculation_3494021491781632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[store_name] + &quot; — &quot; + [product_name]' />
