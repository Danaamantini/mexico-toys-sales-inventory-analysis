    <worksheet name='Inventory value by status'>
      <table>
        <view>
          <datasources>
            <datasource caption='inventory_analysis' name='federated.1w4pout1fqh8nl1c1nkue13endzq' />
          </datasources>
          <datasource-dependencies datasource='federated.1w4pout1fqh8nl1c1nkue13endzq'>
            <column caption='Inventory — Status' datatype='string' name='[Calculation_1691371717758978]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [inventory_status]&#10;WHEN &quot;Stockout with recent demand&quot; THEN &quot;Urgent&quot;&#10;WHEN &quot;Critical cover under 7 days&quot; THEN &quot;Urgent&quot;&#10;WHEN &quot;Low cover 7-13 days&quot; THEN &quot;Watch&quot;&#10;WHEN &quot;Balanced cover 14-30 days&quot; THEN &quot;Balanced&quot;&#10;WHEN &quot;High cover over 30 days&quot; THEN &quot;High / idle&quot;&#10;WHEN &quot;No recent sales&quot; THEN &quot;High / idle&quot;&#10;WHEN &quot;Missing inventory record&quot; THEN &quot;Data review&quot;&#10;END' />
            </column>
            <column caption='Inventory Cost Value' datatype='real' default-format='c&quot;$&quot;#,##0,.0K;-&quot;$&quot;#,##0,.0K' name='[inventory_cost_value]' role='measure' type='quantitative' />
            <column caption='Inventory Status' datatype='string' name='[inventory_status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1691371717758978]' derivation='None' name='[none:Calculation_1691371717758978:nk]' pivot='key' type='nominal' />
            <column-instance column='[inventory_status]' derivation='None' name='[none:inventory_status:nk]' pivot='key' type='nominal' />
            <column-instance column='[inventory_cost_value]' derivation='Sum' name='[sum:inventory_cost_value:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1w4pout1fqh8nl1c1nkue13endzq].[none:inventory_status:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:inventory_status:nk]' member='&quot;Balanced cover 14-30 days&quot;' />
              <groupfilter function='member' level='[none:inventory_status:nk]' member='&quot;Critical cover under 7 days&quot;' />
              <groupfilter function='member' level='[none:inventory_status:nk]' member='&quot;High cover over 30 days&quot;' />
              <groupfilter function='member' level='[none:inventory_status:nk]' member='&quot;Low cover 7-13 days&quot;' />
              <groupfilter function='member' level='[none:inventory_status:nk]' member='&quot;No recent sales&quot;' />
            </groupfilter>
          </filter>
          <filter class='quantitative' column='[federated.1w4pout1fqh8nl1c1nkue13endzq].[sum:inventory_cost_value:qk]' included-values='non-null' />
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.1w4pout1fqh8nl1c1nkue13endzq].[none:inventory_status:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.1w4pout1fqh8nl1c1nkue13endzq].[sum:inventory_cost_value:qk]' shelf='rows' />
